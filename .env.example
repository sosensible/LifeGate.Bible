# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Which deployment this is ------------------------------------------------
# dev | preview | staging | production
#
# NOT the same as NODE_ENV: staging and preview are production builds and run
# with NODE_ENV=production, so only this says which site is the real one.
# Anything but `production` is refused the real mail transport, and leaving it
# unset refuses too -- a deployment that forgets to declare itself sends
# nothing rather than emailing the congregation from a rehearsal.
APP_ENV=dev

# --- Better Auth -------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin people use to reach this instance. Magic-link and reset emails
# point here. Dev: http://localhost:3007 · Preview: https://new.lifegate.bible
BETTER_AUTH_URL=http://localhost:3007
# Extra origins allowed to submit auth requests (comma-separated).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3007,https://new.lifegate.bible

# --- Database ----------------------------------------------------------------
# SQLite file. Relative paths resolve from the project root.
DATABASE_PATH=.data/lifegate.db

# --- Mail --------------------------------------------------------------------
# smtp       -> any SMTP server; in development this is MailPit on the ZimaOS box
# cloudflare -> Cloudflare Email Service (production only; refuses otherwise)
MAIL_TRANSPORT=smtp
SMTP_HOST=zimaos.local
SMTP_PORT=1025
MAIL_FROM="Lifegate Baptist Church <no-reply@lifegate.bible>"
# Where the public contact form is delivered. Nothing is stored, so this is the
# only copy -- a wrong address loses messages silently.
CONTACT_EMAIL=info@lifegate.bible
# For MAIL_TRANSPORT=cloudflare: the account, and an API token with email
# sending permission. The MAIL_FROM domain must be onboarded to Email Sending.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# --- Stewardship ---------------------------------------------------------------
# SimpleFIN Bridge access URL (contains credentials; keep secret). Get one with:
#   npm run simplefin:claim -- <setup token>
# Leave empty to run without the bank; manual accounts still work.
SIMPLEFIN_ACCESS_URL=
# Time zone for bank transaction dates.
CHURCH_TIME_ZONE=America/Detroit

# The Google Calendar the /calendar page reads. The calendar must be public;
# the feed needs no API key. Leave unset to use the church's own calendar.
CHURCH_CALENDAR_ID=

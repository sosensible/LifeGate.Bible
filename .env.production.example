# Copy to .env.production on the ZimaOS box. Read by docker-compose.yml.
#
# This is the only deployment that reaches real people: real mail, the real
# bank connection, real member records. Everything here is a secret.
#
# APP_ENV, NUXT_PUBLIC_SITE_URL and NUXT_PUBLIC_INDEXABLE are set in
# docker-compose.yml, not here. APP_ENV=production is what unlocks the real
# mail transport, so nothing else may set it.

# --- Better Auth -------------------------------------------------------------
# Its own secret, shared with nothing: openssl rand -base64 32
BETTER_AUTH_SECRET=
# new.lifegate.bible until the church goes live, then lifegate.bible. Change
# this and NUXT_PUBLIC_SITE_URL in docker-compose.yml together, and restart --
# emailed sign-in links are built from this, so a stale value sends people to
# the old host.
BETTER_AUTH_URL=https://new.lifegate.bible
BETTER_AUTH_TRUSTED_ORIGINS=https://new.lifegate.bible

# --- Database ----------------------------------------------------------------
# Inside the container, on the production-data volume. Member photos live
# beside it, so both are covered by one backup of this directory.
DATABASE_PATH=/app/.data/lifegate.db

# --- Mail --------------------------------------------------------------------
# Cloudflare Email Service. Refused unless APP_ENV is exactly "production".
# The MAIL_FROM domain must be onboarded to Email Sending first.
MAIL_TRANSPORT=cloudflare
MAIL_FROM="Lifegate Baptist Church <no-reply@lifegate.bible>"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# --- Stewardship ---------------------------------------------------------------
# Contains credentials. Only this environment should hold one.
SIMPLEFIN_ACCESS_URL=
CHURCH_TIME_ZONE=America/Detroit

CHURCH_CALENDAR_ID=

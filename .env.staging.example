# Copy to .env.staging on the ZimaOS box. Read by docker-compose.yml.
#
# Staging is a rehearsal against real code and FAKE data. Seed it from
# scripts/seed-demo.ts -- never from a copy of production, because the
# directory holds addresses, birthdays and photos that members chose who may
# see them, and those choices do not travel with a database file.
#
# APP_ENV, NUXT_PUBLIC_SITE_URL and NUXT_PUBLIC_INDEXABLE are set in
# docker-compose.yml, not here, so they cannot drift.

# --- Better Auth -------------------------------------------------------------
# Generate a DIFFERENT secret from production: openssl rand -base64 32
# Sharing one would let a session minted on staging be replayed on the real site.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://staging.lifegate.bible
BETTER_AUTH_TRUSTED_ORIGINS=https://staging.lifegate.bible

# --- Database ----------------------------------------------------------------
# Inside the container, on the staging-data volume. Member photos live beside it.
DATABASE_PATH=/app/.data/lifegate.db

# --- Mail --------------------------------------------------------------------
# MailPit, so a rehearsal cannot reach a real mailbox. server/lib/mail.ts also
# refuses the Cloudflare transport here regardless of what this says, because
# APP_ENV is not "production" -- belt and braces, deliberately.
MAIL_TRANSPORT=smtp
SMTP_HOST=zimaos.local
SMTP_PORT=1025
MAIL_FROM="Lifegate STAGING <no-reply@lifegate.bible>"

# --- Stewardship ---------------------------------------------------------------
# Leave empty. Pointing staging at the real SimpleFIN URL would burn the
# church's ~24-requests-a-day budget and pull real bank data into fake records.
SIMPLEFIN_ACCESS_URL=
CHURCH_TIME_ZONE=America/Detroit

# Leave unset to read the church's real (public) calendar, which is harmless.
CHURCH_CALENDAR_ID=
